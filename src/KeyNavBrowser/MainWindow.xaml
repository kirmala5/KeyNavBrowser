<Window x:Class="KeyNavBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:KeyNavBrowser.Models"
        xmlns:conv="clr-namespace:KeyNavBrowser.Converters"
        Title="KeyNav Browser"
        Height="820" Width="1320" MinHeight="480" MinWidth="860"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBgBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True"
        Loaded="OnWindowLoaded"
        PreviewKeyDown="OnWindowPreviewKeyDown"
        Closing="OnWindowClosing">

    <Window.Resources>
        <conv:BoolToVisibilityConverter x:Key="BoolToVis" />
        <conv:StringToVisibilityConverter x:Key="StringToVis" />

        <!-- Кнопка панели инструментов -->
        <Style x:Key="ToolButton" TargetType="Button">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Margin" Value="1,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource HoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background"
                                        Value="{DynamicResource PressedBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Заголовок вкладки -->
        <DataTemplate x:Key="TabHeaderTemplate" DataType="{x:Type models:TabModel}">
            <Border x:Name="TabRoot"
                    Margin="0,3,2,0"
                    CornerRadius="7,7,0,0"
                    BorderThickness="1"
                    BorderBrush="Transparent"
                    Background="Transparent"
                    MouseLeftButtonUp="OnTabHeaderClick">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="10,0,2,0">
                        <TextBlock x:Name="TitleText"
                                   Text="{Binding Title}"
                                   TextTrimming="CharacterEllipsis"
                                   MaxWidth="190"
                                   VerticalAlignment="Center"
                                   FontSize="12.5"
                                   ToolTip="{Binding Url}" />
                    </Grid>

                    <Button Grid.Column="1"
                            x:Name="CloseButton"
                            Content="&#x2715;"
                            Width="20" Height="20"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Symbol"
                            FontSize="10"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand"
                            Focusable="False"
                            Click="OnTabCloseClick" />
                </Grid>
            </Border>

            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsActive}" Value="True">
                    <Setter TargetName="TabRoot" Property="Background"
                            Value="{DynamicResource SelectedBrush}" />
                    <Setter TargetName="TabRoot" Property="BorderBrush"
                            Value="{DynamicResource AccentBrush}" />
                    <Setter TargetName="TitleText" Property="FontWeight" Value="SemiBold" />
                    <Setter TargetName="TitleText" Property="Foreground"
                            Value="{DynamicResource TextPrimaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsActive}" Value="False">
                    <Setter TargetName="TitleText" Property="Foreground"
                            Value="{DynamicResource TextSecondaryBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsLoading}" Value="True">
                    <Setter TargetName="CloseButton" Property="Content" Value="&#x25CF;" />
                    <Setter TargetName="CloseButton" Property="FontSize" Value="9" />
                    <Setter TargetName="CloseButton" Property="Foreground"
                            Value="{DynamicResource AccentBrush}" />
                </DataTrigger>
                <Trigger SourceName="TabRoot" Property="IsMouseOver" Value="True">
                    <Setter TargetName="TabRoot" Property="Background"
                            Value="{DynamicResource TabHoverBrush}" />
                </Trigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- 0: полоса вкладок -->
            <RowDefinition Height="Auto" />   <!-- 1: панель навигации -->
            <RowDefinition Height="Auto" />   <!-- 2: индикатор загрузки -->
            <RowDefinition Height="*" />      <!-- 3: содержимое -->
            <RowDefinition Height="Auto" />   <!-- 4: строка состояния -->
        </Grid.RowDefinitions>

        <!-- ================= Полоса вкладок ================= -->
        <Border Grid.Row="0"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="6,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ScrollViewer Grid.Column="0"
                              HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="TabsControl"
                                  ItemsSource="{Binding Tabs}"
                                  ItemTemplate="{StaticResource TabHeaderTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>

                <Button Grid.Column="1"
                        Style="{StaticResource ToolButton}"
                        Content="+"
                        FontSize="16"
                        ToolTip="Новая вкладка (Ctrl+T)"
                        Click="OnNewTabClick" />
            </Grid>
        </Border>

        <!-- ================= Панель навигации ================= -->
        <Border Grid.Row="1"
                Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <Grid Margin="8,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button x:Name="BackButton" Style="{StaticResource ToolButton}"
                            Content="&#x2190;" ToolTip="Назад (Alt+Влево)"
                            Click="OnBackClick" />
                    <Button x:Name="ForwardButton" Style="{StaticResource ToolButton}"
                            Content="&#x2192;" ToolTip="Вперёд (Alt+Вправо)"
                            Click="OnForwardClick" />
                    <Button x:Name="ReloadButton" Style="{StaticResource ToolButton}"
                            Content="&#x21BB;" ToolTip="Обновить (F5)"
                            Click="OnReloadClick" />
                    <Button x:Name="HomeButton" Style="{StaticResource ToolButton}"
                            Content="&#x2302;" ToolTip="Домой"
                            Click="OnHomeClick" />
                    <Button x:Name="ZoomResetButton" Style="{StaticResource ToolButton}"
                            Content="&#x2212;" FontFamily="Segoe UI, Segoe UI Symbol"
                            FontSize="13" ToolTip="Уменьшить масштаб (Ctrl+−)"
                            Click="OnZoomOutClick" />
                    <Button x:Name="ZoomInButton" Style="{StaticResource ToolButton}"
                            Content="+" FontSize="14"
                            ToolTip="Увеличить масштаб (Ctrl++)"
                            Click="OnZoomInClick" />
                </StackPanel>

                <!-- Адресная строка: № 1 ТЗ -->
                <Grid Grid.Column="1" Margin="10,0,8,0" VerticalAlignment="Center">
                    <Border Background="{DynamicResource InputBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="7">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="AddressBox"
                                     Grid.Column="0"
                                     Padding="10,7"
                                     FontSize="13"
                                     FontFamily="Segoe UI, Consolas"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                     CaretBrush="{DynamicResource TextPrimaryBrush}"
                                     SelectionBrush="{DynamicResource AccentBrush}"
                                     KeyDown="OnAddressBoxKeyDown"
                                     GotFocus="OnAddressBoxGotFocus"
                                     LostFocus="OnAddressBoxLostFocus"
                                     ToolTip="Введите URL или поисковый запрос (Ctrl+L)" />

                            <Button x:Name="GoButton" Grid.Column="1"
                                    Style="{StaticResource ToolButton}"
                                    Content="&#x21B5;"
                                    Margin="2,2,2,2"
                                    ToolTip="Перейти"
                                    Click="OnGoClick" />
                        </Grid>
                    </Border>
                </Grid>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Режим отображения контента (ТЗ: три режима) -->
                    <ComboBox x:Name="ContentModeBox"
                              Width="150"
                              Margin="0,0,8,0"
                              Padding="6,3"
                              FontSize="12"
                              VerticalAlignment="Center"
                              Background="{DynamicResource InputBgBrush}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              BorderBrush="{DynamicResource BorderBrush}"
                              SelectionChanged="OnContentModeChanged"
                              ToolTip="Что показывать на странице" />
                    <Button x:Name="BookmarkButton" Style="{StaticResource ToolButton}"
                            Content="&#x2606;" ToolTip="Добавить закладку (Ctrl+B)"
                            Click="OnBookmarkClick" />
                    <Button x:Name="HistoryButton" Style="{StaticResource ToolButton}"
                            Content="&#x1F5D;" FontSize="13"
                            ToolTip="История (Ctrl+H)" Click="OnHistoryClick" />
                    <Button x:Name="BookmarksButton" Style="{StaticResource ToolButton}"
                            Content="&#x2630;" ToolTip="Закладки (Ctrl+O)" Click="OnBookmarksClick" />
                    <Button x:Name="SettingsButton" Style="{StaticResource ToolButton}"
                            Content="&#x2699;" ToolTip="Настройки" Click="OnSettingsClick" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Индикатор загрузки (№ 8 ТЗ) ================= -->
        <ProgressBar x:Name="LoadingBar"
                     Grid.Row="2"
                     Height="3"
                     Minimum="0" Maximum="100"
                     Background="{DynamicResource TrackBrush}"
                     Foreground="{DynamicResource AccentBrush}"
                     BorderThickness="0"
                     Visibility="Collapsed" />

        <!-- ================= Содержимое: WebView2 активной вкладки ================= -->
        <Grid x:Name="WebViewHost" Grid.Row="3" Background="{DynamicResource SurfaceBrush}">
            <TextBlock x:Name="EmptyPlaceholder"
                       Text="Вкладок нет — нажмите Ctrl+T"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       FontSize="15"
                       Visibility="Collapsed" />
        </Grid>

        <!-- ================= Строка состояния ================= -->
        <Border Grid.Row="4"
                Background="{DynamicResource SurfaceAltBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding ActiveTab.StatusText}"
                           FontSize="11.5"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <TextBlock x:Name="ZoomText"
                               FontSize="11.5"
                               Margin="0,0,14,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               VerticalAlignment="Center" />
                    <TextBlock x:Name="KeyboardNavIndicator"
                               FontSize="11.5"
                               VerticalAlignment="Center"
                               ToolTip="W/S/A/D — прокрутка, ПРОБЕЛ — экран, Q/E — ссылки, 1–9 — переход по номеру, ENTER — открыть, ESC — сброс" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>